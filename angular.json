{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "gateway": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        },
        "@schematics/angular:application": {
          "strict": true
        }
      },
      "root": "",
      "sourceRoot": "src/main/webapp",
      "prefix": "jhi",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "preserveSymlinks": true,
            "allowedCommonJsDependencies": ["codemirror", "buffer"],
            "outputPath": {
              "base": "build/resources/main/static",
              "browser": ""
            },
            "index": "src/main/webapp/index.html",
            "browser": "src/main/webapp/main.ts",
            "polyfills": ["src/main/webapp/polyfills.ts"],
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "stylePreprocessorOptions": {
              "includePaths": ["src", "node_modules"]
            },
            "assets": [
              "src/main/webapp/content",
              "src/main/webapp/favicon.ico",
              "src/main/webapp/logo_lightmode.svg",
              "src/main/webapp/logo_darkmode.svg",
              "src/main/webapp/manifest.webapp",
              "src/main/webapp/robots.txt"
            ],
            "styles": [
              "node_modules/@foblex/flow/styles/default.scss",
              "src/main/webapp/content/scss/vendor.scss",
              "src/main/webapp/content/scss/global.scss"
            ],
            "scripts": [],
            "define": {
              "__TYPE__": "'FULL'"
            }
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "400kb",
                  "maximumError": "500kb"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "namedChunks": true
            },
            "headless": {
              "define": {
                "__TYPE__": "'HEADLESS'"
              }
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "gateway:build:development",
            "port": 4200,
            "proxyConfig": "proxy.conf.mjs"
          },
          "configurations": {
            "production": {
              "buildTarget": "gateway:build:production"
            },
            "development": {
              "buildTarget": "gateway:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular-builders/jest:run",
          "options": {
            "configPath": "jest.conf.cjs",
            "tsConfig": "tsconfig.spec.json"
          }
        }
      }
    }
  },
  "cli": {
    "cache": {
      "enabled": true,
      "path": "./build/angular/",
      "environment": "all"
    },
    "packageManager": "npm"
  }
}
