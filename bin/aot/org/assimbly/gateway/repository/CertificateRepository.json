    {
      "name": "findAllByCertificateExpiryBetween",
      "signature": "public abstract java.util.List<org.assimbly.gateway.domain.Certificate> org.assimbly.gateway.repository.CertificateRepository.findAllByCertificateExpiryBetween(java.time.Instant,java.time.Instant)",
      "query": {
        "query": "SELECT c FROM Certificate c WHERE c.certificateExpiry BETWEEN :now AND :expiryDate"
      }
    },
    {
      "name": "findAllByUrl",
      "signature": "public abstract java.util.List<org.assimbly.gateway.domain.Certificate> org.assimbly.gateway.repository.CertificateRepository.findAllByUrl(java.lang.String)",
      "query": {
        "query": "SELECT c FROM Certificate c WHERE c.url = :url"
      }
    },
    {
      "name": "findByCertificateName",
      "signature": "public abstract java.util.Optional<org.assimbly.gateway.domain.Certificate> org.assimbly.gateway.repository.CertificateRepository.findByCertificateName(java.lang.String)",
      "query": {
        "query": "SELECT c FROM Certificate c WHERE c.certificateName = :certificateName"
      }
