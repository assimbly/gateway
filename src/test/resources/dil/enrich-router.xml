<?xml version="1.0" encoding="UTF-8"?>
<dil>
  <integrations>
    <integration>
      <id>1</id>
      <name>roundtrip</name>
      <type>FULL</type>
      <options>
        <environment>test</environment>
        <stage>TEST</stage>
      </options>
      <flows>
        <flow>
          <id>enrich-flow</id>
          <name>EnrichRouterFlow</name>
          <type>esb</type>
          <steps>
            <step>
              <id>error</id>
              <type>error</type>
              <uri>failedexchange</uri>
            </step>
            <step>
              <id>source</id>
              <type>source</type>
              <uri>timer:tick</uri>
              <links><link><id>router</id><bound>out</bound><transport>sync</transport></link></links>
            </step>
            <step>
              <id>router</id>
              <type>router</type>
              <uri>enrich</uri>
              <options><enrichType>override</enrichType></options>
              <links><link><id>router</id><bound>in</bound><transport>sync</transport></link><link><id>sink-after</id><bound>out</bound><transport>sync</transport></link><link><id>sink-enrich</id><bound>out</bound><transport>sync</transport><rule>enrich</rule></link></links>
            </step>
            <step>
              <id>sink-after</id>
              <type>sink</type>
              <uri>log:sink-after</uri>
              <links><link><id>sink-after</id><bound>in</bound><transport>sync</transport></link></links>
            </step>
            <step>
              <id>sink-enrich</id>
              <type>sink</type>
              <uri>log:sink-enrich</uri>
              <links><link><id>sink-enrich</id><bound>in</bound><transport>sync</transport></link></links>
            </step>
          </steps>
        </flow>
      </flows>
    </integration>
  </integrations>
  <core/>
</dil>
