<?xml version="1.0" encoding="UTF-8"?>
<dil>
  <integrations>
    <integration>
      <id>1</id>
      <name>roundtrip</name>
      <type>FULL</type>
      <options>
        <environment>test</environment>
        <stage>TEST</stage>
      </options>
      <flows>
        <flow>
          <id>content-router-flow</id>
          <name>ContentRouterFlow</name>
          <type>esb</type>
          <steps>
            <step>
              <id>error</id>
              <type>error</type>
              <uri>failedexchange</uri>
            </step>
            <step>
              <id>source</id>
              <type>source</type>
              <uri>timer:tick</uri>
              <coordinates><x>40</x><y>120</y></coordinates>
              <links>
                <link><id>router</id><bound>out</bound><transport>sync</transport></link>
              </links>
            </step>
            <step>
              <id>router</id>
              <type>router</type>
              <uri>content</uri>
              <coordinates><x>280.5</x><y>120</y></coordinates>
              <links>
                <link><id>router</id><bound>in</bound><transport>sync</transport></link>
                <link><id>sink-default</id><bound>out</bound><transport>sync</transport><pattern>InOut</pattern></link>
                <link><id>sink-check</id><bound>out</bound><transport>sync</transport><pattern>InOut</pattern><rule>check</rule><language>simple</language><expression>${body} contains 'x'</expression></link>
              </links>
            </step>
            <step>
              <id>sink-default</id>
              <type>sink</type>
              <uri>log:default</uri>
              <links>
                <link><id>sink-default</id><bound>in</bound><transport>sync</transport></link>
              </links>
            </step>
            <step>
              <id>sink-check</id>
              <type>sink</type>
              <uri>log:check</uri>
              <links>
                <link><id>sink-check</id><bound>in</bound><transport>sync</transport></link>
              </links>
            </step>
          </steps>
        </flow>
      </flows>
    </integration>
  </integrations>
  <core/>
</dil>
