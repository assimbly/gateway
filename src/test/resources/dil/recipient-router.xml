<?xml version="1.0" encoding="UTF-8"?>
<dil>
  <integrations>
    <integration>
      <id>1</id>
      <name>roundtrip</name>
      <type>FULL</type>
      <options>
        <environment>test</environment>
        <stage>TEST</stage>
      </options>
      <flows>
        <flow>
          <id>recipient-flow</id>
          <name>RecipientRouterFlow</name>
          <type>esb</type>
          <steps>
            <step>
              <id>error</id>
              <type>error</type>
              <uri>failedexchange</uri>
            </step>
            <step>
              <id>source</id>
              <type>source</type>
              <uri>timer:tick</uri>
              <links><link><id>router</id><bound>out</bound><transport>sync</transport></link></links>
            </step>
            <step>
              <id>router</id>
              <type>router</type>
              <uri>recipient</uri>
              <links><link><id>router</id><bound>in</bound><transport>sync</transport></link><link><id>sink-a</id><bound>out</bound><transport>sync</transport><pattern>InOnly</pattern></link><link><id>sink-b</id><bound>out</bound><transport>sync</transport><pattern>InOnly</pattern></link><link><id>sink-c</id><bound>out</bound><transport>sync</transport><pattern>InOut</pattern></link></links>
            </step>
            <step>
              <id>sink-a</id>
              <type>sink</type>
              <uri>log:sink-a</uri>
              <links><link><id>sink-a</id><bound>in</bound><transport>sync</transport></link></links>
            </step>
            <step>
              <id>sink-b</id>
              <type>sink</type>
              <uri>log:sink-b</uri>
              <links><link><id>sink-b</id><bound>in</bound><transport>sync</transport></link></links>
            </step>
            <step>
              <id>sink-c</id>
              <type>sink</type>
              <uri>log:sink-c</uri>
              <links><link><id>sink-c</id><bound>in</bound><transport>sync</transport></link></links>
            </step>
          </steps>
        </flow>
      </flows>
    </integration>
  </integrations>
  <core/>
</dil>
