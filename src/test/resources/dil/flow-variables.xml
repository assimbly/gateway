<?xml version="1.0" encoding="UTF-8"?>
<dil>
  <integrations>
    <integration>
      <id>1</id>
      <name>roundtrip</name>
      <type>FULL</type>
      <options>
        <environment>test</environment>
        <stage>TEST</stage>
      </options>
      <flows>
        <flow>
          <id>flow-variables-flow</id>
          <name>FlowVariablesFlow</name>
          <type>esb</type>
          <variables>
            <variable><key>name</key><value>@{tenant}.txt</value></variable>
            <variable><key>inbox</key><value>/data/flow-in</value></variable>
          </variables>
          <steps>
            <step>
              <id>error</id>
              <type>error</type>
              <uri>failedexchange</uri>
            </step>
            <step>
              <id>source</id>
              <type>source</type>
              <uri>file:@{inbox}</uri>
              <links>
                <link><id>sink</id><bound>out</bound><transport>sync</transport></link>
              </links>
            </step>
            <step>
              <id>sink</id>
              <type>sink</type>
              <uri>file:@{outbox}</uri>
              <options>
                <fileName>@{name}</fileName>
                <doneFileName>@{missing}</doneFileName>
              </options>
              <links>
                <link><id>sink</id><bound>in</bound><transport>sync</transport></link>
              </links>
            </step>
          </steps>
        </flow>
      </flows>
    </integration>
  </integrations>
  <core/>
</dil>
