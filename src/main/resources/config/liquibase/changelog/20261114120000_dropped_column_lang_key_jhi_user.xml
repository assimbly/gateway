<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">

    <!-- The Gateway is English only, so users no longer have a language -->
    <changeSet id="20261114120000-1" author="gateway">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="jhi_user" columnName="lang_key"/>
        </preConditions>
        <dropColumn tableName="jhi_user" columnName="lang_key"/>
    </changeSet>

</databaseChangeLog>
